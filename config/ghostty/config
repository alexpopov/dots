theme = Apple System Colors Light

# Match iTerm2 "Default" profile: SFMono Nerd Font (SFMonoNF-Regular) @ 12
font-family = "SFMono Nerd Font"
font-size = 12

# iTerm2 default profile colors: white bg, near-black (#1a1a1a) fg
background = ffffff
foreground = 1a1a1a

# iTerm2 has a blinking box cursor
cursor-style = block
cursor-style-blink = true

# Copy on select to system clipboard (middle-click paste is always on)
copy-on-select = clipboard

# Ctrl+V to paste
keybind = ctrl+v=paste_from_clipboard

# Per-user overrides written by bootstrap.sh (e.g. for $USER == cay).
# The `?` makes it optional — no error when the file is absent.
config-file = ?local.conf
