#!/bin/sh
#
# tmux-window-picker <client-tty>: fuzzy-pick any window in any session and
# jump to it. For when there are more tabs than prefix-0..9 can reach or the
# status bar can show. tmux.conf: prefix f, and in the prefix-i menu.
#
# Call it via `run-shell "... '#{client_tty}'"`: run-shell fills in the
# format, display-popup (and its -e) does NOT, and a bare switch-client in
# the popup moves the most recently active client, which is the wrong one when
# the Mac and a devserver are both attached. So this script opens its own
# popup on that client and re-runs itself inside it.
#
# Rows: a yellow ● for windows with a waiting agent (see tmux-agent-waiting),
# a * for the window you're on, then session:index, name, and cwd.

client="$1"
if [ "$2" != --in-popup ]; then
  exec tmux display-popup ${client:+-c "$client"} -E -w 70% -h 60% -b rounded \
    -s "bg=#193549,fg=white" -S "fg=#007EF8,bg=#193549" \
    -T "#[align=centre,fg=#32D330,bold] windows " "'$0' '$client' --in-popup"
fi

pink=$(printf '\033[38;2;255;86;129m'); dim=$(printf '\033[2m'); off=$(printf '\033[0m')

# Field 1 (hidden) is the target; fzf shows and searches the rest.
sel=$(tmux list-windows -a -F "#{session_name}:#{window_index}	#{?#{P:#{@agent_waiting}},${pink}●${off}, }#{?#{&&:#{window_active},#{session_attached}},*, } #{p6:#{session_name}:#{window_index}}#{p24:#{=/22/…:window_name}}${dim}#{s|^$HOME|~|:pane_current_path}${off}" |
  fzf --ansi --delimiter='	' --with-nth=2.. --reverse --no-info --no-scrollbar \
      --color='bg:#193549,fg:#ffffff,bg+:#FFBE33,fg+:#193549,hl:#32D330,hl+:#004796,prompt:#32D330,pointer:#193549,gutter:#193549,query:#ffffff:bold' \
      --prompt='window> ' --pointer='▶' --padding=0,1 --cycle) || exit 0

tmux switch-client ${client:+-c "$client"} -t "${sel%%	*}"
